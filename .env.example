# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key, bypasses RLS. Used for anonymous link creation and
# redirect/click recording in route handlers and proxy.ts. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical app domain (no trailing slash, no www) used to build shortUrl
# responses instead of the request's Host header — avoids leaking a www.
# redirect domain into generated short links. Falls back to the request
# origin when unset, which is fine for local dev.
NEXT_PUBLIC_SITE_URL=https://j1n.uk
